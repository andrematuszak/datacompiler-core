+def test_fusion_de_zones_jusqu_a_stabilite():
+    """Une zone recouverte par le rectangle ENGLOBANT d'une composante (sans toucher aucun de
+    ses membres) doit être absorbée, sinon l'OCR la lit deux fois."""
+    from datacompiler.frontend.ocr.vector_zones import _fusionner_zones_chevauchantes
+    haut_gauche = BBox(0, 0, 10, 10)
+    haut_droit = BBox(9, 0, 30, 10)      # touche haut_gauche
+    bas_droit = BBox(25, 9, 40, 40)      # touche haut_droit : l'englobant va jusqu'à y=40
+    isole = BBox(1, 20, 8, 30)           # ne touche personne mais tombe dans l'englobant
+    resultat = _fusionner_zones_chevauchantes([haut_gauche, haut_droit, bas_droit, isole])
+    assert len(resultat) == 1
+    b = resultat[0]
+    assert (b.x0, b.y0, b.x1, b.y1) == (0, 0, 40, 40)
