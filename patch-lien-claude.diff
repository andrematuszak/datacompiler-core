+def test_chaque_mot_du_lien_est_lu_une_seule_fois(doc_page1):
+    """Le rectangle englobant d'un groupe de zones peut recouvrir une zone non membre : sans
+    fusion jusqu'à stabilité, elle était lue deux fois (« en » en double)."""
+    page = doc_page1.pages[0]
+    par_id = {w.id: w for w in page.resolved.words}
+    texte = [par_id[i].text for i in page.links[0].word_ids]
+    assert len(texte) == len(set(texte)) == 12
